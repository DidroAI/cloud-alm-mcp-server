{
  "name": "cloud-alm-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for SAP Cloud ALM: projects, requirements, features, test cases, processes, landscape and analytics, read-only",
  "license": "MIT",
  "author": "Didro",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sap",
    "sap-cloud-alm",
    "cloud-alm",
    "alm",
    "agent",
    "claude",
    "codex"
  ],
  "homepage": "https://github.com/DidroAI/cloud-alm-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DidroAI/cloud-alm-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DidroAI/cloud-alm-mcp-server.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cloud-alm-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js http",
    "check:live": "bun scripts/live-check.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
