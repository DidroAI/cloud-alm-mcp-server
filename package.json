{
  "name": "cloud-alm-mcp-server",
  "version": "0.3.2",
  "mcpName": "io.github.DidroAI/cloud-alm-mcp-server",
  "description": "MCP server for SAP Cloud ALM: projects, requirements, features, test cases, processes, landscape and analytics; writes wait for the user's approval",
  "license": "MIT",
  "author": {
    "name": "Didro",
    "url": "https://didro.ai"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sap",
    "sap-cloud-alm",
    "cloud-alm",
    "alm",
    "agent",
    "claude",
    "codex",
    "sap-btp",
    "application-lifecycle-management",
    "requirements",
    "test-management",
    "fit-gap",
    "claude-desktop",
    "claude-code",
    "cursor",
    "ai-agent",
    "mcp-apps"
  ],
  "homepage": "https://github.com/DidroAI/cloud-alm-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DidroAI/cloud-alm-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DidroAI/cloud-alm-mcp-server.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cloud-alm-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/icon.png",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "scopes",
    "skills",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "test:hosted": "node --test hosted/test/feedback.mjs",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js http",
    "check:live": "bun scripts/live-check.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2"
  }
}
